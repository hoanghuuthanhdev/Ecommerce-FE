# Point this at your backend's API root. The app expects REST endpoints at:
#   GET {VITE_API_BASE_URL}/products
#   GET {VITE_API_BASE_URL}/products/:id
#
# Accepted response shapes for GET /products: [...] or { data: [...] } or { products: [...] }
# Accepted response shapes for GET /products/:id: {...} or { data: {...} } or { product: {...} }
#
# Expected product fields: id, name, price, currency, category, description, image, productAvailable, sku
# (extra fields are ignored; missing optional fields degrade gracefully)

VITE_API_BASE_URL=http://localhost:8000/api
